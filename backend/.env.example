#backend/.env.example
# Copier ce fichier en `.env` et renseigner les valeurs.
# En production, l'application REFUSE de demarrer si les secrets JWT sont
# les valeurs "change-me" ci-dessous ou font moins de 32 caracteres.
# Generer un secret : openssl rand -base64 48

# --- Base de donnees (Neon Postgres) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth ---
# Deux secrets DIFFERENTS (access et refresh).
JWT_SECRET="change-me-super-secret-access"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-super-secret-refresh"
JWT_REFRESH_EXPIRES_IN="30d"
INVITATION_TOKEN_EXPIRES_IN_HOURS=48

# --- App ---
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:3000"

# Nombre de proxys de confiance devant l'API (rate-limit, IP d'audit).
# Vide : 1 en production, aucun en dev. Exemples : 1, 2, loopback.
# Ne PAS mettre "true" (IP falsifiable via X-Forwarded-For).
TRUST_PROXY=""

# --- Emails (SMTP via nodemailer) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="Suivi de Chantier <notifications@ton-domaine.com>"
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000

# --- WhatsApp / SMS (Twilio) : facultatif ---
# Sans ces variables, seuls les emails et les notifications dans l'application sont utilises.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_SMS_FROM=""
MESSAGING_TIMEOUT_MS=5000

# --- Taches planifiees (rapport mensuel, alertes d'expiration, rappels) ---
# Secret partage avec le planificateur : GET /api/cron/daily avec "Authorization: Bearer <CRON_SECRET>".
# Generer : openssl rand -base64 32
CRON_SECRET=""

# --- Stockage fichiers (S3 / R2 / Supabase Storage - compatible S3) ---
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET="chantier-files"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""
# true : bucket PRIVE, les fichiers sont lus via des URL signees a duree limitee.
STORAGE_PRIVATE=false
STORAGE_SIGNED_URL_TTL_SECONDS=900
STORAGE_MAX_FILE_SIZE_MB=15

# --- Regles metier ---
DEFAULT_CURRENCY="GNF"
# Fenetre (heures) de cumul des depenses pour la detection de fractionnement.
EXPENSE_CUMULATIVE_WINDOW_HOURS=24

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Seed (npm run prisma:seed) ---
# Utilises UNIQUEMENT si aucun SUPERADMIN n'existe encore. Aucun identifiant par
# defaut : sans ces deux variables, le seed ne cree pas de superadmin.
# Mot de passe : 12 caracteres minimum, au moins une lettre et un chiffre.
# Retirer ces lignes du .env une fois le premier superadmin cree.
# SEED_SUPERADMIN_EMAIL="admin@ton-domaine.com"
# SEED_SUPERADMIN_PASSWORD=""
